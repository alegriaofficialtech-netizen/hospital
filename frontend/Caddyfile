{
	admin off
}

# Both names are served on purpose. The Keycloak client registers
# http://127.0.0.1:4200/* and http://localhost:4200/*, and the browser reaches
# the stack through the SSH tunnel with whatever Host it was opened with. A
# single address would answer with an empty body for the other one.
http://127.0.0.1:4200, http://localhost:4200 {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	encode gzip zstd

	route {
		@api path /api/*
		reverse_proxy @api 127.0.0.1:8010

		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
